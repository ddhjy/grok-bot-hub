---
const raw = import.meta.env.BASE_URL;
const home = raw.endsWith("/") ? raw : `${raw}/`;
const github = "https://github.com/ddhjy/grok-bot-hub";
---

<header class="site-header">
  <div class="wrap header-row">
    <a class="brand" href={home}>
      <svg class="brand-seal" viewBox="0 0 32 32" aria-hidden="true">
        <rect width="32" height="32" rx="7" fill="#c23b22"></rect>
        <rect x="7" y="8" width="18" height="2.4" rx="1.2" fill="#f3eee4"></rect>
        <rect x="7" y="14.8" width="14" height="2.4" rx="1.2" fill="#f3eee4"></rect>
        <rect x="7" y="21.6" width="10" height="2.4" rx="1.2" fill="#f3eee4"></rect>
      </svg>
      <span class="brand-mark">Grok Bot 目录</span>
    </a>
    <div class="header-actions">
      <span class="badge" title="非官方站点，与 xAI、Cursor 无隶属关系">非官方</span>
      <a class="header-github" href={github} rel="noopener noreferrer" target="_blank" title="本站源码仓库">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path fill="currentColor" d="M12 2C6.48 2 2 6.58 2 12.26c0 4.52 2.87 8.35 6.84 9.71.5.1.68-.22.68-.49 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.36 1.12 2.94.86.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.27 2.75 1.05A9.3 9.3 0 0 1 12 6.84c.85 0 1.71.12 2.51.35 1.91-1.32 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9 0 1.38-.01 2.49-.01 2.83 0 .27.18.6.69.49A10.03 10.03 0 0 0 22 12.26C22 6.58 17.52 2 12 2Z"/>
        </svg>
        <span>GitHub</span>
      </a>
    </div>
  </div>
</header>
