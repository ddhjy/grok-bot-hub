---
interface Props {
  showHome?: boolean;
}

const { showHome = false } = Astro.props;
const home = import.meta.env.BASE_URL;
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p>非官方社区目录，与 xAI、SpaceXAI、Cursor 无隶属关系。</p>
      <p class="footer-license">代码 MIT · 目录 CC0 1.0 · 2026 KAI ddhjy</p>
    </div>
    <nav class="footer-links" aria-label="页脚链接">
      {showHome && <a href={home}>首页</a>}
      <a href="https://github.com/ddhjy/grok-bot-hub">GitHub</a>
      <a href="https://x.ai/bot">官方产品页</a>
      <a href="https://github.com/ddhjy/grok-bot-hub/blob/main/CONTRIBUTING.zh.md">如何提交一条</a>
    </nav>
  </div>
</footer>
