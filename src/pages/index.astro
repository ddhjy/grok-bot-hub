---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Directory from "../components/Directory.astro";
import { displayTitle, allEntriesNewest } from "../lib/catalog";

const visibleEntries = allEntriesNewest();
const visibleTotal = visibleEntries.length;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Grok Bot 目录",
  description: "常驻云电脑队友的中文目录。非官方精选。",
  numberOfItems: visibleTotal,
  itemListElement: visibleEntries.map((entry, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: displayTitle(entry),
    url: entry.url,
    description: entry.blurb,
  })),
};
---

<Base
  title="Grok Bot 目录"
  description="常驻云电脑队友的中文目录。精选官方文档、教程、技能和踩坑，不是 grok.com 聊天、Grok Imagine 或 Grok 4.x 模型评测。"
>
  <Header />
  <main id="main" tabindex="-1">
    <h1 class="visually-hidden">Grok Bot 目录</h1>
    <Directory />
  </main>
  <Footer />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</Base>
