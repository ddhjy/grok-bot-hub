---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Directory from "../components/Directory.astro";
import { catalog } from "../lib/catalog";
---

<Base title="Grok Bot 导航" description="非官方 Grok Bot 资源导航。常驻云电脑队友的精选目录，不是 grok.com 聊天。">
  <Header />
  <main id="main">
    <section class="hero">
      <div class="wrap">
        <p class="badge">非官方 · {catalog.entries.length} 条精选</p>
        <h1>Grok Bot 导航</h1>
        <p class="tagline">常驻云电脑队友的非官方目录。内容写在 Git 里，这个静态站只负责给人看。</p>
        <p class="lede">
          Grok Bot 是 2026-08-11 由 xAI/SpaceXAI 与 Cursor 推出的 always-on AI 队友，不是 grok.com
          聊天、Grok Imagine，也不是 Grok 4.x 模型文章。
        </p>
      </div>
    </section>
    <Directory />
  </main>
  <Footer />
</Base>
