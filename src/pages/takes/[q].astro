---
import fs from "node:fs";
import path from "node:path";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Directory from "../../components/Directory.astro";
import {
  TAKES_OG,
  canonicalShareQuery,
  sectionSearchTitle,
  sectionSearchDescription,
  shareSectionQueryPairs,
  sectionQueryOgFile,
} from "../../lib/catalog";

export function getStaticPaths() {
  return shareSectionQueryPairs()
    .filter((item) => item.section === "takes")
    .map((item) => ({ params: { q: item.q } }));
}

const raw = decodeURIComponent(Astro.params.q ?? "");
const q = canonicalShareQuery(raw);
const title = sectionSearchTitle("takes", q);
const description = sectionSearchDescription("takes", q);
const ogName = sectionQueryOgFile("takes", q);
const ogExists = fs.existsSync(path.join(process.cwd(), "public", ogName));
const ogImage = ogExists ? ogName : TAKES_OG.image;
---

<Base
  title={title}
  description={description}
  ogImage={ogImage}
  ogImageAlt={`${title}，非官方`}
  noindex
>
  <Header />
  <main id="main" tabindex="-1">
    <section class="hero hero-section">
      <div class="wrap">
        <h1>观点与实测</h1>
        <p class="tagline">{description}</p>
      </div>
    </section>
    <Directory initialSection="takes" initialQuery={q} />
  </main>
  <Footer showHome />
</Base>
