---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const home = import.meta.env.BASE_URL;
---

<Base title="页面不存在 · Grok Bot 目录" description="这个地址在 Grok Bot 目录里不存在。" noindex>
  <Header />
  <main id="main" class="wrap not-found">
    <p class="badge">404</p>
    <h1>没有这一页</h1>
    <p class="tagline">目录里找不到这个地址。回到首页，用搜索找官方文档、教程和踩坑帖。</p>
    <a class="home-link" href={home}>回首页搜索</a>
  </main>
  <Footer showHome />
</Base>
